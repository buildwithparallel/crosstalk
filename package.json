{
  "name": "crosstalk",
  "version": "2.5.4",
  "desktopName": "crosstalk",
  "description": "Field-focused Reticulum messaging with native Iridium IMT support",
  "author": "Build with Parallel",
  "repository": "https://github.com/buildwithparallel/crosstalk",
  "main": "electron/main.js",
  "scripts": {
    "watch": "npm run build-frontend -- --watch",
    "build-frontend": "vite build",
    "build-backend": "python setup.py build",
    "build": "npm run build-frontend && npm run build-backend",
    "electron-postinstall": "electron-builder install-app-deps",
    "electron": "npm run electron-postinstall && npm run build && electron .",
    "dist": "npm run electron-postinstall && npm run build && electron-builder --publish=never"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "@phosphor-icons/core": "^2.1.1"
  },
  "build": {
    "appId": "com.buildwithparallel.crosstalk",
    "productName": "Crosstalk",
    "asar": false,
    "files": [
      "electron/**/*",
      "!**/node_modules/@phosphor-icons/**"
    ],
    "directories": {
      "buildResources": "electron/build"
    },
    "mac": {
      "target": "dmg",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Crosstalk-v${version}-macOS-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Microphone access is needed for audio calls and voice messages",
        "com.apple.security.device.audio-input": true
      },
      "extraFiles": [
        {
          "from": "build/exe",
          "to": "Resources/app/electron/build/exe",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "artifactName": "Crosstalk-v${version}-Windows-${arch}.${ext}",
      "target": [
        {
          "target": "portable"
        },
        {
          "target": "nsis"
        }
      ],
      "extraFiles": [
        {
          "from": "build/exe",
          "to": "Resources/app/electron/build/exe",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "artifactName": "Crosstalk-v${version}-Linux.${ext}",
      "target": "AppImage",
      "category": "Network",
      "syncDesktopName": true,
      "extraFiles": [
        {
          "from": "build/exe",
          "to": "resources/app/electron/build/exe",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "portable": {
      "artifactName": "Crosstalk-v${version}-Windows-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "Crosstalk-v${version}-Windows-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@tailwindcss/forms": "^0.5.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "axios": "^1.10.0",
    "click-outside-vue3": "^4.0.1",
    "compressorjs": "^1.2.1",
    "micron-parser": "^1.0.2",
    "mitt": "^3.0.1",
    "moment": "^2.30.1",
    "postcss": "^8.4.49",
    "protobufjs": "^7.4.0",
    "tailwindcss": "^3.4.17",
    "vis-data": "^7.1.9",
    "vis-network": "^9.1.9",
    "vite": "^6.0.5",
    "vite-plugin-vuetify": "^2.0.4",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.6"
  }
}
