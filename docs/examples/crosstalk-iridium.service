[Unit]
Description=Crosstalk with RockBLOCK 9704 Iridium IMT
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/pi-zero-iridium-reticulum/crosstalk
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/pi-zero-iridium-reticulum/.venv/bin/python /home/pi/pi-zero-iridium-reticulum/crosstalk/crosstalk.py --headless --host 0.0.0.0 --port 8000 --reticulum-config-dir /home/pi/pi-zero-iridium-reticulum/crosstalk-reticulum --storage-dir /home/pi/pi-zero-iridium-reticulum/crosstalk-storage
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
