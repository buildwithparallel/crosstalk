# Minimal Crosstalk/Reticulum configuration for a computer physically
# connected to a RockBLOCK 9704. Copy this file to the Reticulum config
# directory selected with Crosstalk's --reticulum-config-dir option.

[reticulum]
  share_instance = No
  instance_name = crosstalk-iridium
  enable_transport = No

[logging]
  loglevel = 5

[interfaces]

  [[Iridium IMT]]
    type = IridiumIMTInterface
    interface_enabled = Yes
    port = /dev/ttyUSB0
    topic = 244
    bitrate = 300
    poll_interval = 0.01
    retry_interval = 30
    maximum_queued_packets = 512

    # Optional, comma-separated LXMF destination hashes whose authenticated
    # paths should survive a Crosstalk/Pi restart. Keep this list narrow on a
    # paid satellite edge; it does not enable Reticulum transport.
    # persistent_destinations = 0123456789abcdef0123456789abcdef
    # persistent_path_max_age = 604800
